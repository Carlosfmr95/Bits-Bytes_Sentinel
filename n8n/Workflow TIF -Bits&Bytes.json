    {
      "parameters": {
        "jsCode": "\n// Tope de seguridad del loop de polling.\n\nconst MAX_POLLS = 24;\n\n// Estados terminales de GVM que NO son 'Done'. Si caemos en uno,\n// el scan murio y seguir poleando es un cuelgue infinito.\nconst TERMINALES = ['Stopped', 'Interrupted', 'Failed', 'Unknown'];\n\nconst intento  = $runIndex + 1;\nconst item     = $input.first().json;\nconst status   = item.status ?? '(primer intento, sin status aun)';\nconst progreso = item.progress_pct ?? 0;\n\nif (TERMINALES.includes(item.status)) {\n  throw new Error(\n    `Escaneo abortado: GVM devolvio estado terminal \"${item.status}\" ` +\n    `en el intento ${intento}. Task: ${item.task_id ?? 'desconocida'}.`\n  );\n}\n\nif (intento > MAX_POLLS) {\n  throw new Error(\n    `Tope de polling agotado: ${MAX_POLLS} intentos x 5 min = ${MAX_POLLS * 5} min. ` +\n    `Ultimo status: \"${status}\" (${progreso}%). Task: ${item.task_id ?? 'desconocida'}.`\n  );\n}\n\nconsole.log(`[polling] intento ${intento}/${MAX_POLLS} - status: ${status} - ${progreso}%`);\n\nreturn $input.all();"
      },
