  "nodes": [
    {
      "parameters": {},
      "id": "3b8720e9-ab20-41fd-91e3-0b79c2d55d6b",
      "name": "▶ Ejecutar Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -624,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst pad = n => String(n).padStart(2, '0');\n\n// Intentar leer el scan_id que mandó el dashboard via Webhook.\n// Si el workflow fue disparado por Manual Trigger o Schedule, este bloque\n// falla silenciosamente y se genera un ID propio.\nlet scan_id = null;\nlet webhook_target = null;\nlet webhook_scan_type = null;\n\ntry {\n  const wb   = $('Webhook - Dashboard').first().json;\n  const data = wb.body || wb;\n\n  if (data && data.scan_id) {\n    scan_id           = data.scan_id;\n    webhook_target    = data.target    || null;\n    webhook_scan_type = data.scan_type || null;\n  }\n} catch (e) {\n  // No viene del Webhook — es Manual o Schedule, sin problema\n}\n\n// Si no vino del Webhook, generar el ID propio (formato original)\nif (!scan_id) {\n  scan_id = `SCAN-${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;\n}\n\nreturn [{ json: { scan_id, webhook_target, webhook_scan_type } }];"
      },
      "id": "f3ee05c2-6f6f-4d4a-a5e0-c4de2503922b",
      "name": "Generar Scan ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const scan_id = $('Generar Scan ID').first().json.scan_id;\nconst ahora = new Date().toLocaleString('sv-SE', { timeZone: 'America/Argentina/Buenos_Aires' }).replace(' ', 'T');\nconst nmapRows = $('Agregar Resultados Nmap1').all().map(i => i.json);\nconst openvasResultados = $('OpenVAS - Obtener Reporte1').first().json.resultados || [];\nconst rows = [];\n\nfor (const h of nmapRows) {\n  if (!h.host_ip) continue;\n  for (const p of (h.puertos || [])) {\n    rows.push({\n      scan_id, fecha: ahora, host_ip: h.host_ip, herramienta: 'nmap',\n      severidad_label: p.severidad, puerto: String(p.puerto),\n      servicio: p.servicio || null, version: p.version || null,\n      nombre_vuln: null, cves: null, severidad_cvss: null\n    });\n  }\n}\n\nfor (const v of openvasResultados) {\n  rows.push({\n    scan_id, fecha: ahora, host_ip: v.host, herramienta: 'openvas',\n    severidad_label: v.severidad_label, puerto: v.puerto || null,\n    servicio: null, version: null, nombre_vuln: v.nombre || null,\n    cves: (v.cves || []).join(',') || null, severidad_cvss: v.severidad_cvss || null\n  });\n}\n\nif (rows.length === 0) return [];\nreturn rows.map(r => ({ json: r }));"
      },
      "id": "d311e1d9-e47b-4321-8445-fc2ba64871a6",
      "name": "Preparar filas para DB",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2800,
        528
      ]
    },
    {
      "parameters": {
        "jsCode": "const scan_id = $('Generar Scan ID').first().json.scan_id;\nconst ahora = new Date().toLocaleString('sv-SE', { timeZone: 'America/Argentina/Buenos_Aires' }).replace(' ', 'T');\nconst nmapRows = $('Agregar Resultados Nmap1').all().map(i => i.json);\nconst resumen = $('OpenVAS - Obtener Reporte1').first().json.resumen || {};\n\nlet nmapHigh = 0, nmapMedium = 0, nmapLow = 0;\nfor (const h of nmapRows) {\n  nmapHigh   += h.high   || 0;\n  nmapMedium += h.medium || 0;\n  nmapLow    += h.low    || 0;\n}\n\nreturn [{\n  json: {\n    scan_id, fecha: ahora,\n    total_hosts: nmapRows.length,\n    nmap_high: nmapHigh, nmap_medium: nmapMedium, nmap_low: nmapLow,\n    openvas_critical: resumen.critical || 0,\n    openvas_high: resumen.high || 0,\n    openvas_medium: resumen.medium || 0,\n    openvas_low: resumen.low || 0\n  }\n}];"
      },
